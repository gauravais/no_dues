# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nodues_db
POSTGRES_USER=nodues_user
POSTGRES_PASSWORD=changeme

# App
APP_ENV=development

# Seed
SEED_DEFAULT_PASSWORD=changeme_seed
SEED_STAFF_EMAIL_DOMAIN=svsu.ac.in

# JWT Authentication (Required: app refuses to start if missing)
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS & Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_EMAIL_DOMAINS=svsu.ac.in

# Email & OTP
MAIL_CONSOLE_ONLY=true
DEV_RETURN_OTP=false

# SMTP & Real Email Outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@svsu.ac.in
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=no-reply@svsu.ac.in
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_ALLOWLIST=
REMINDERS_ENABLED=false
REMINDER_AFTER_DAYS=3

# Swagger / OpenAPI
ENABLE_DOCS=true

# Public Base URL (for certificate QR code verification link)
PUBLIC_BASE_URL=http://localhost:8000

# Bank Data Encryption Key (Required: Fernet 32-byte urlsafe base64 key; app refuses to start without it)
BANK_DATA_KEY=replace_with_a_fernet_key_generate_with_Fernet_generate_key

# Google Authentication & Login Gate Flags
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=svsu.ac.in
AUTH_OTP_SIGNUP_ENABLED=false
AUTH_PASSWORD_LOGIN_FOR_STUDENTS=false

# Rate Limiting & Proxy Configuration
# Empty = strictly use direct TCP socket address (request.client.host).
# On Render production: set explicitly to True-Client-IP (Cloudflare edge) or CF-Connecting-IP
TRUSTED_CLIENT_IP_HEADER=


