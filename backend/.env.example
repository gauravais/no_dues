# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nodues_db
POSTGRES_USER=nodues_user
POSTGRES_PASSWORD=changeme

# App
APP_ENV=development

# Seed
SEED_DEFAULT_PASSWORD=changeme_seed

# JWT Authentication (Required: app refuses to start if missing)
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS & Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_EMAIL_DOMAINS=example.edu

# Email & OTP
MAIL_CONSOLE_ONLY=true
DEV_RETURN_OTP=false

# Swagger / OpenAPI
ENABLE_DOCS=true

# Public Base URL (for certificate QR code verification link)
PUBLIC_BASE_URL=http://localhost:8000

